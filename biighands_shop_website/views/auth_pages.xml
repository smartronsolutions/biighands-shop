<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
<record id="bhs_auth_css" model="ir.ui.view">
<field name="name">biighands_shop.auth_css</field><field name="key">biighands_shop_website.auth_css</field>
<field name="inherit_id" ref="website.layout"/><field name="type">qweb</field><field name="arch" type="xml">
<xpath expr="//head" position="inside"><style>
html:has(.oe_website_login_container) body,html:has(.oe_website_login_container) body.bg-100{background:#050505!important;color:#f3f0e9!important}html:has(.oe_website_login_container) #wrapwrap>main{padding-top:72px!important;background:#050505!important}
#wrapwrap .oe_website_login_container{position:relative!important;display:grid!important;grid-template-columns:1fr 1fr;align-items:stretch!important;min-height:calc(100vh - 72px)!important;padding:0!important;overflow:hidden!important;background:#050505!important;font-family:Inter,"Segoe UI",Arial,sans-serif}
#wrapwrap .oe_website_login_container:before{content:'CLIENT ATELIER\A\A “Every frame, made to measure — down to the millimetre.”';white-space:pre-wrap;position:absolute;z-index:2;left:3.4vw;bottom:7%;width:430px;color:#f2f0e9;font:500 23px/1.45 Inter,"Segoe UI",sans-serif;letter-spacing:-.02em;pointer-events:none}
#wrapwrap .oe_website_login_container:after{content:'';position:absolute;z-index:1;inset:0 50% 0 0;background:linear-gradient(180deg,rgba(3,7,8,.28),rgba(3,7,8,.3) 55%,rgba(3,7,8,.76)),url('/biighands_shop_website/static/src/img/auth-villa.jpg') center/cover no-repeat;pointer-events:none}
#wrapwrap .oe_website_login_container{padding:7vh clamp(42px,12vw,255px) 7vh calc(50% + clamp(42px,12vw,255px))!important;display:flex!important;flex-direction:column;align-items:stretch!important;justify-content:center;position:relative;z-index:3;background:radial-gradient(circle at 76% 44%,#0a0a09 0,#050505 55%,#030303 100%)}
#wrapwrap .oe_website_login_container>.bhp-auth-tabs,#wrapwrap .oe_website_login_container>form,#wrapwrap .oe_website_login_container>.alert,#wrapwrap .oe_website_login_container>.bhp-auth-guest,#wrapwrap .oe_website_login_container>.oe_structure,#wrapwrap .oe_website_login_container>owl-component{width:100%!important;max-width:448px!important;margin-left:auto!important;margin-right:auto!important;position:relative;z-index:3}
.bhp-auth-tabs{display:flex;gap:32px;border-bottom:1px solid #252522;margin:0 0 54px}.bhp-auth-tabs a{position:relative;padding:0 0 18px;color:#8c8b86!important;font:500 11px/1 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.3em;text-transform:uppercase;text-decoration:none!important}.bhp-auth-tabs a.active{color:#d6ab31!important}.bhp-auth-tabs a.active:after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:1px;background:#d6ab31}
#wrapwrap .oe_website_login_container .mb-3,#wrapwrap .oe_website_login_container .field-password{margin:0 0 34px!important;padding:0!important}#wrapwrap .oe_website_login_container label{margin:0 0 14px!important;color:#d0cec7!important;font:500 9px/1 ui-monospace,SFMono-Regular,Consolas,monospace!important;letter-spacing:.32em!important;text-transform:uppercase}#wrapwrap .oe_website_login_container .form-control{height:46px!important;padding:5px 0!important;border:0!important;border-bottom:1px solid #292927!important;border-radius:0!important;background:transparent!important;color:#f4f1ea!important;font-size:16px!important;box-shadow:none!important}#wrapwrap .oe_website_login_container .form-control::placeholder{color:#4c4c48!important}#wrapwrap .oe_website_login_container .form-control:focus{border-bottom-color:#b38a2c!important;box-shadow:none!important;background:transparent!important}
#wrapwrap .oe_website_login_container .o_show_password{height:46px!important;border:0!important;border-bottom:1px solid #292927!important;border-radius:0!important;background:transparent!important;color:#817f78!important}#wrapwrap .oe_website_login_container .btn-primary{width:100%;height:49px!important;border:1px solid #f2f1ed!important;border-radius:0!important;background:#f2f1ed!important;color:#111!important;font:500 11px/1 ui-monospace,SFMono-Regular,Consolas,monospace!important;letter-spacing:.25em!important;text-transform:uppercase;box-shadow:none!important}#wrapwrap .oe_website_login_container .btn-primary:after{content:'  →'}#wrapwrap .oe_website_login_container .btn-primary:hover{background:#d6ab31!important;border-color:#d6ab31!important}
#wrapwrap .oe_website_login_container .btn-link,#wrapwrap .oe_website_login_container a.btn-link{color:#77756f!important;font:500 9px/1.4 ui-monospace,SFMono-Regular,Consolas,monospace!important;letter-spacing:.2em!important;text-transform:uppercase;text-decoration:none!important}#wrapwrap .oe_website_login_container .btn-link:hover{color:#d6ab31!important}#wrapwrap .oe_website_login_container .alert{border-radius:0!important;background:#221010!important;border:1px solid #5d2929!important;color:#e9b8b8!important;font-size:12px!important}.bhp-auth-guest{display:block;margin-top:38px;text-align:center;color:#4f4e49!important;font:500 8px/1 ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:.34em;text-transform:uppercase;text-decoration:none!important}.bhp-auth-guest:hover{color:#d6ab31!important}
@media(max-width:1050px){#wrapwrap .oe_website_login_container{padding-left:57vw!important;padding-right:7vw!important}}@media(max-width:760px){html:has(.oe_website_login_container) #wrapwrap>main{padding-top:64px!important}#wrapwrap .oe_website_login_container{display:flex!important;min-height:calc(100vh - 64px)!important;padding:42vh 24px 60px!important;background:linear-gradient(180deg,transparent 0,transparent 28vh,#050505 38vh)!important}#wrapwrap .oe_website_login_container:after{inset:0;height:34vh;opacity:.55}#wrapwrap .oe_website_login_container:before{display:none}.bhp-auth-tabs{margin-bottom:42px}}
</style><script type="text/javascript">
(function () {
  function mountBiighandsAuth() {
    var host = document.querySelector('.oe_website_login_container');
    if (!host || host.querySelector('.bhp-auth-tabs')) return;
    var form = host.querySelector('form.oe_login_form, form.oe_signup_form, form.oe_reset_password_form');
    if (!form) return;
    var path = window.location.pathname;
    var signup = path.indexOf('/web/signup') === 0;
    var nav = document.createElement('nav');
    nav.className = 'bhp-auth-tabs';
    nav.setAttribute('aria-label', 'Account access');
    nav.innerHTML = '&lt;a href="/web/login" class="' + (signup ? '' : 'active') + '"&gt;Sign In&lt;/a&gt;' +
      '&lt;a href="/web/signup" class="' + (signup ? 'active' : '') + '"&gt;Create Account&lt;/a&gt;';
    form.parentNode.insertBefore(nav, form);
    var guest = document.createElement('a');
    guest.href = '/catalogue';
    guest.className = 'bhp-auth-guest';
    guest.textContent = 'Continue browsing as guest';
    form.parentNode.insertBefore(guest, form.nextSibling);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mountBiighandsAuth);
  else mountBiighandsAuth();
  window.addEventListener('pageshow', mountBiighandsAuth);
}());
</script></xpath></field></record>
</data></odoo>
