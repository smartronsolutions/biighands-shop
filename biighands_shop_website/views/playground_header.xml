<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
  <template id="remove_unused_fontawesome_preload" inherit_id="web.frontend_layout" name="Disabled Font Awesome Preload Override" priority="200" active="False">
    <xpath expr="//link[@rel='preload' and contains(@href, 'fontawesome-webfont.woff2')]" position="replace"/>
  </template>

  <template id="playground_header" inherit_id="website.layout" name="Playground Atelier Header" priority="120">
    <xpath expr="//head" position="inside">
      <link rel="preconnect" href="https://fonts.googleapis.com"/>
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&amp;family=JetBrains+Mono:wght@400;500&amp;family=Manrope:wght@300;400;500;600;700&amp;display=swap"/>
    </xpath>
    <xpath expr="//header" position="replace">
      <header id="bhp-top" class="bhp-site-header">
        <div class="bhp-header-inner">
          <a href="/" class="bhp-wordmark" aria-label="Playground home"><img src="/biighands_shop_website/static/src/img/logo.png" alt="Playground"/></a>
          <nav class="bhp-main-nav" aria-label="Main navigation">
            <a href="/catalogue">Catalogue</a>
            <a href="/">Craft</a>
            <a href="/my/quotes">My Quotes</a>
          </nav>
          <div class="bhp-header-account">
            <a t-if="website.is_public_user()" href="/web/login" class="bhp-login">Client Login</a>
            <a t-else="" href="/my/home" class="bhp-login">My Account</a>
            <button type="button" class="bhp-menu-toggle" aria-label="Open menu" aria-expanded="false"><span/><span/></button>
          </div>
        </div>
        <div class="bhp-mobile-menu">
          <a href="/catalogue">Catalogue</a><a href="/">Craft</a><a href="/my/quotes">My Quotes</a><a href="/contactus">Contact</a>
        </div>
      </header>
    </xpath>
  </template>
</data>
</odoo>
